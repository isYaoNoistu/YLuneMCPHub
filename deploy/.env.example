# 复制为本目录 .env 后再改。不要把填好的 .env 提交进仓库。
# 口令请改成你自己的，不要用下面的占位符上生产。

# 宿主机访问月弦的端口（容器内固定 3000）
YLUNE_PORT=3000

# 首次启动时创建管理员的密码。已经有管理员之后改这里不会改库里的密码。
ADMIN_PASSWORD=change-me-admin

# 容器内 Postgres 口令。出现在 DB_URL 里，请用字母数字，避免 @ : / # 等特殊字符。
DB_PASSWORD=change-me-db

# 反代挂在子路径时才填，例如 /ylune。走根路径请留空。
# 填了之后还要把 nginx 换成 nginx.subpath.conf.example 的内容，两边必须一致。
BASE_PATH=

# 可选：构建或运行时走国内 npm
# NPM_REGISTRY=https://registry.npmmirror.com

# 可选：启用 --profile proxy 时，宿主机 HTTP 端口
# NGINX_HTTP_PORT=80

# 可选：把宿主机上的 Linux 二进制挂进容器（同时取消 compose 里对应 volumes 注释）
# DEVOPSMCP_BIN_DIR=/opt/devopsmcp

# 可选：需要从宿主机连容器 Postgres 时，取消 compose 里 postgres.ports 注释后使用
# PUBLISH_DB_PORT=5432

# 可选：空库一次性灌入旧 JSON。成功后删文件、去掉这个变量。配置只认 Postgres。
# YLUNE_IMPORT_SETTINGS_FILE=
