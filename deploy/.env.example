# 复制为本目录 .env 后再改。不要把填好的 .env 提交进仓库。
# 口令请改成你自己的，不要用下面的占位符上生产。

# 宿主机访问月弦的端口（容器内固定 3000）
YLUNE_PORT=3000

# 首次启动时创建管理员的密码。已经有管理员之后改这里不会改库里的密码。
ADMIN_PASSWORD=change-me-admin

# 容器内 Postgres 口令。出现在 DB_URL 里，请用字母数字，避免 @ : / # 等特殊字符。
DB_PASSWORD=change-me-db

# 反代挂在子路径时才填，例如 /ylune。走根路径请留空。
# 填了之后还要把 nginx 换成 nginx.subpath.conf.example 的内容，两边必须一致。
BASE_PATH=

# 构建与运行默认走国内源（Debian / Node 二进制 / npm / PyPI）
NPM_REGISTRY=https://registry.npmmirror.com
DEBIAN_MIRROR=https://mirrors.aliyun.com/debian
DEBIAN_SECURITY_MIRROR=https://mirrors.aliyun.com/debian-security
NODE_DIST_MIRROR=https://npmmirror.com/mirrors/node
PYPI_INDEX=https://mirrors.aliyun.com/pypi/simple

# 可选：启用 --profile proxy 时，宿主机 HTTP 端口
# NGINX_HTTP_PORT=80

# 月弦容器内固定挂到 /opt/mcp。空目录即可，不要把 Token 放这里。
# DevOpsMCP 的 deploy/attach.sh 会往这个目录写二进制和 Postgres 清单。
MCP_MOUNT_DIR=/data/ylune-mcp

# 配置库镜像。默认官方 postgres:16（本机已有就不用再拉）。
# 智能路由（/mcp/$smart）需要向量扩展：POSTGRES_IMAGE=pgvector/pgvector:pg16
# 不必升到 17。换大版本不要复用旧数据卷，先 pg_dump 再新卷恢复。
POSTGRES_IMAGE=postgres:16

# 可选：需要从宿主机连容器 Postgres 时，取消 compose 里 postgres.ports 注释后使用
# PUBLISH_DB_PORT=5432

# 可选：空库一次性灌入旧 JSON。成功后删文件、去掉这个变量。配置只认 Postgres。
# YLUNE_IMPORT_SETTINGS_FILE=
